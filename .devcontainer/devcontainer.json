{
  "name": "PDND Interop full stack",
  "dockerComposeFile": [
    "../../interop-be-monorepo/docker/docker-compose.yml",
    "../../interop-be-monorepo/.local-development/dashboard/compose.yml"
  ],
  "service": "dashboard",
  "runServices": ["dashboard"],
  "workspaceFolder": "${localWorkspaceFolder}",
  "initializeCommand": ["bash", ".devcontainer/initialize.sh"],
  "overrideCommand": false,
  "shutdownAction": "none",
  "remoteUser": "node",
  "updateRemoteUserUID": false,
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "remote.restoreForwardedPorts": false,
        "remote.forwardOnOpen": false
      },
      "extensions": [
        "dbaeumer.vscode-eslint",
        "editorconfig.editorconfig",
        "esbenp.prettier-vscode",
        "ms-azuretools.vscode-docker"
      ]
    }
  }
}
